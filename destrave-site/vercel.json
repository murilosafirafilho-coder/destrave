{
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/brinde",
      "destination": "/brinde/",
      "permanent": false
    },
    {
      "source": "/termos",
      "destination": "/termos/",
      "permanent": false
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade/",
      "permanent": false
    },
    {
      "source": "/privado/:arquivo*",
      "destination": "/brinde/",
      "permanent": false
    }
  ],
  "functions": {
    "api/brinde.js": {
      "includeFiles": "privado/**"
    }
  }
}
